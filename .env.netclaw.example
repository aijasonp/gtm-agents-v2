# GTM fleet settings. Copy to .env (alongside the existing gtm-agents settings).

# ---- Models (any provider NetClaw supports: anthropic, openai, openrouter, ollama, ...)
MAIN_MODEL_TYPE=anthropic
MAIN_MODEL_ID=claude-sonnet-4-5
SMALL_MODEL_TYPE=ollama
SMALL_MODEL_ID=qwen3:14b
SMALL_MODEL_ENDPOINT=http://ollama.internal:11434
# Provider keys go in NetClaw secrets or the provider's NETCLAW_ env var.

# ---- Slack: one app per instance (Socket Mode), plus the instance's main channel ID
PIPELINE_SLACK_BOT_TOKEN=xoxb-...
PIPELINE_SLACK_APP_TOKEN=xapp-...
PIPELINE_SLACK_CHANNEL_ID=C00000001
DEALS_SLACK_BOT_TOKEN=xoxb-...
DEALS_SLACK_APP_TOKEN=xapp-...
DEALS_SLACK_CHANNEL_ID=C00000002
REVOPS_SLACK_BOT_TOKEN=xoxb-...
REVOPS_SLACK_APP_TOKEN=xapp-...
REVOPS_SLACK_CHANNEL_ID=C00000003

# ---- Customer MCP servers (streamable HTTP endpoints)
CRM_MCP_URL=https://crm-mcp.internal/mcp
WORKSPACE_MCP_URL=https://workspace-mcp.internal/mcp
ENRICHMENT_MCP_URL=https://enrichment-mcp.internal/mcp
SEQUENCER_MCP_URL=https://sequencer-mcp.internal/mcp
CALLS_MCP_URL=https://calls-mcp.internal/mcp

# ---- Webhook shared secrets (HMAC-SHA256 of the raw body)
WEBHOOK_SECRET_INBOUND_LEAD=change-me
WEBHOOK_SECRET_CALL_COMPLETED=change-me
WEBHOOK_SECRET_DEAL_CLOSED=change-me

# ---- Scoring engine (JEV or CLEF)
TYPESAFE_BACKEND=clef
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
# TYPESAFE_API_KEY=            # only for TYPESAFE_BACKEND=jev

# ---- Forecast report branding
REPORT_COMPANY=
REPORT_ACCENT=#1F4E79
REPORTS_FOLDER_ID=
REPORT_SHARE_WITH=
