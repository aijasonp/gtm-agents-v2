# Copy to .env on the customer's machine. Never commit .env.
# Database (docker compose sets DATABASE_URL for you)
POSTGRES_PASSWORD=change-me
# DATABASE_URL=sqlite:///gtm.db

# Model gateway: the customer's own keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     # any OpenAI-compatible endpoint, incl. open-weight servers
GTM_MODEL_CHEAP=claude-haiku-5-5
GTM_MODEL_FRONTIER=claude-sonnet-5-5
# GTM_MODEL_PRICES={"claude-sonnet-5-5": [3, 15]}   # USD per million tokens (input, output): set contract rates

# Budgets: auto-pause and Slack alert when hit
GTM_DAILY_TOKEN_BUDGET=2000000
GTM_MONTHLY_USD_BUDGET=150

# CRM: hubspot or salesforce
GTM_CRM=hubspot
HUBSPOT_TOKEN=
# SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com
# SALESFORCE_ACCESS_TOKEN=

# Slack: webhook or bot token
SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
SLACK_CHANNEL=#gtm-signals
