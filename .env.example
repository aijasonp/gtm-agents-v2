# Copy to .env on the customer's machine. Never commit .env.
# Database (docker compose sets DATABASE_URL for you)
POSTGRES_PASSWORD=change-me
# DATABASE_URL=sqlite:///gtm.db

# Model gateway: the customer's own keys. Two tiers, each can point anywhere (see docs/RUNNING.md).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     # default OpenAI-compatible endpoint for both tiers
GTM_MODEL_CHEAP=claude-haiku-5-5
GTM_MODEL_FRONTIER=claude-sonnet-5-5
# Per-tier overrides. Example: cheap tier on a local open-weight model, frontier on Claude.
# GTM_MODEL_CHEAP=qwen2.5:14b
# GTM_CHEAP_BASE_URL=http://ollama:11434/v1      # vLLM: http://vllm:8000/v1, Together: https://api.together.xyz/v1
# GTM_CHEAP_API_KEY=                             # empty for a server on your own VM
# GTM_FRONTIER_BASE_URL=
# GTM_FRONTIER_API_KEY=
# GTM_ASSISTANT_TIER=frontier                    # model tier the chat assistant uses
# GTM_ASSISTANT_AGENTS=                          # limit tools for small models, e.g. rep-brief,lead-triage
# GTM_OFFLINE=1                                  # never call a model (templates only)
# GTM_MODEL_PRICES={"claude-sonnet-5-5": [3, 15]}   # USD per million tokens (input, output): set contract rates

# Budgets: auto-pause and Slack alert when hit
GTM_DAILY_TOKEN_BUDGET=2000000
GTM_MONTHLY_USD_BUDGET=150

# CRM: hubspot or salesforce
GTM_CRM=hubspot
HUBSPOT_TOKEN=
# SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com
# SALESFORCE_ACCESS_TOKEN=

# Slack: webhook or bot token
SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
SLACK_CHANNEL=#gtm-signals

# Outbound delivery after approval: none | webhook | smartlead | lemlist
GTM_SEQUENCER=none
# GTM_SEQUENCER_WEBHOOK=https://hooks.example.com/gtm     # Clay, n8n, Make, Zapier, or your sequencer's automation
# GTM_SEQUENCER_SECRET=
# SMARTLEAD_API_KEY=
# SMARTLEAD_CAMPAIGN_ID=
# LEMLIST_API_KEY=                 # GTM_SEQUENCER=lemlist
# LEMLIST_CAMPAIGN_ID=

# Signal Sourcing: SEC requires a User-Agent naming the company and a contact email
# GTM_SOURCES_USER_AGENT="Beacon Revenue research@beacon.example"
# CONTEXT_DEV_API_KEY=               # optional news API for accounts with no newsroom feed

# Judged ICP: optional remote decision service (otherwise the model key above, else offline rules)
# GTM_DECISION_URL=
# GTM_DECISION_TOKEN=
# Cloudflare Workers AI Clef for typed decisions (judgment.backend auto or clef in config/icp.yaml)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AUTH_TOKEN=               # a scoped Workers AI token

# Clay table webhook (enrichment push); results come back to POST /v1/enrichment
# GTM_CLAY_WEBHOOK=
# GTM_CLAY_SECRET=

# Call transcripts (Meeting Intelligence pull_transcripts): set any one
# GONG_ACCESS_KEY=
# GONG_ACCESS_SECRET=
# FIREFLIES_API_KEY=
# FATHOM_API_KEY=

# Rep feedback to GitHub PRs (Rep Feedback agent)
# GITHUB_TOKEN=
# GTM_FEEDBACK_REPO=owner/repo
# GTM_FEEDBACK_BASE=main

# Content Studio: approved posts go here (Buffer, Zapier, n8n); empty = post by hand
# GTM_SOCIAL_WEBHOOK=

# HTTP API (docker compose `api` service).
# Intake token: leads, meetings, signals only. Safe to give web forms, event apps, Clay or Zapier. Required.
GTM_API_TOKEN=
# Approver token: the approval queue over HTTP. Leave empty to approve from the CLI only. Must differ from the above.
GTM_API_APPROVER_TOKEN=
GTM_API_APPROVER_NAME=sales-ops
# Also allow running approved actions over HTTP (otherwise: `gtm approvals <agent> execute`)
GTM_API_ALLOW_EXECUTE=0
# Personal approver tokens: each decision is recorded under that person (sends need one).
# GTM_API_APPROVERS={"Sam Rivera": "change-me-sam", "Priya Shah": "change-me-priya"}
# GTM_APPROVER=Sam Rivera               # default --by for `gtm approvals ... approve` on this machine
# GTM_SEQUENCER_SINGLE_CAMPAIGN=        # one-step campaign for pipeline emails and held steps (Smartlead, Lemlist)
# Triage leads the moment they arrive through the API (1) or on the next scheduled run (0)
GTM_API_TRIAGE_NOW=1

# Dialer push after approval: none | webhook (Nooks, Orum, Aircall, Outreach calls via their automation layer)
GTM_DIALER=none
# GTM_DIALER_WEBHOOK=
# GTM_DIALER_SECRET=

# Slack chat bot (docker compose --profile slack up -d). Socket Mode app token + bot token.
# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...
# GTM_SLACK_ALLOWED_USERS=U123,U456              # who may chat with it (required unless GTM_SLACK_ALLOW_ALL=1)
# GTM_SLACK_ALLOW_ALL=0                          # 1 = every member of your workspace (never external Slack Connect users)
# GTM_SLACK_APPROVERS=U123                       # who may type "approve 12" in Slack

# Durable workflows (Follow-Through approval and touch deadlines). builtin needs nothing extra.
# GTM_WORKFLOW_BACKEND=builtin          # or dbos (pip install dbos): escalations fire on time between scheduler ticks
# GTM_DBOS_DATABASE_URL=                # DBOS system database; defaults to DATABASE_URL

# Traces and AE feedback stay in your database. Langfuse is optional (cloud or self-hosted).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# GTM_TRACE_CONTENT=1                   # also keep prompts and outputs on model-call spans (off by default)

# Page change signals: changedetection.io (self-hosted). Push notifications to POST /v1/page-changes, or poll:
# CHANGEDETECTION_URL=http://changedetection:5000
# CHANGEDETECTION_API_KEY=

# First-party web and product signals: PostHog (cloud or self-hosted). Point a webhook destination at
# POST /v1/web-events, or poll the query API every 30 minutes with a personal API key (query read scope):
# POSTHOG_HOST=https://us.posthog.com
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=

# Hosted MCP servers (config/mcp.yaml). Fill tool names with `gtm mcp tools <server>`.
# MOLTSETS_MCP_TOKEN=
# APOLLO_MCP_TOKEN=
# HUBSPOT_MCP_TOKEN=
# FLOQER_MCP_URL=
# FLOQER_MCP_TOKEN=
# Floqer sheet for enrichment pushes (Enrichment push_to_floqer / import_floqer)
# FLOQER_API_KEY=
# FLOQER_WORKFLOW_ID=
# FLOQER_SHEET_ID=

# Optional DSPy pass for drafter examples (pip install dspy). A LiteLLM model name, e.g. anthropic/claude-sonnet-4-5.
# GTM_DSPY_MODEL=
